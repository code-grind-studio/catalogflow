# ---------------------------------------------------------------------------
# CatalogFlow — variabili d'ambiente
# Copia questo file in `.env.local` e riempi i valori.
#   cp .env.example .env.local
# `.env.local` non va mai committato (è già in .gitignore).
# ---------------------------------------------------------------------------

# --- Shopify (obbligatorio) -------------------------------------------------
# Credenziali dell'app creata nel Dev Dashboard: https://dev.shopify.com
# Guida passo-passo con screenshot: docs/SHOPIFY-SETUP.md
#   SHOPIFY_DOMAIN        dominio *.myshopify.com del tuo store (NON il dominio
#                         personalizzato: es. abcde-1f.myshopify.com)
#   SHOPIFY_CLIENT_ID     "ID client" nella pagina Paramètres de l'appli
#   SHOPIFY_CLIENT_SECRET "Secret" nella stessa pagina
SHOPIFY_DOMAIN=iltuo-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Accesso al catalogo (obbligatorio) -------------------------------------
# Password condivise: nessuna email, nessun database utenti.
# Puoi definire fino a 10 utenti: _1_, _2_, ... _10_
#   _ID       identificativo usato al login (minuscolo, senza spazi)
#   _PASSWORD password scelta da te
#   _LABEL    nome mostrato nell'interfaccia (facoltativo, default = ID)
# L'utente 1 è l'admin: è l'unico che può creare o revocare accessi dal dialog
# "Collaboratori" (click sul tuo nome in alto a destra nella pagina del catalogo).
# Gli altri accessi (nome + password) si creano da lì, senza toccare questo file.
CATALOG_USER_1_ID=admin
CATALOG_USER_1_PASSWORD=cambiami
CATALOG_USER_1_LABEL=Admin

# CATALOG_USER_2_ID=socio
# CATALOG_USER_2_PASSWORD=cambiami2
# CATALOG_USER_2_LABEL=Socio

# --- Sessione (obbligatorio) ------------------------------------------------
# Stringa casuale lunga: firma il cookie di sessione (che non scade).
# Generala con:  openssl rand -hex 32
SESSION_SECRET=

# --- Opzionale: log attività, stato import e collaboratori (Upstash Redis) ---
# Se le lasci vuote, log e barra di avanzamento restano in memoria (si perdono
# al riavvio del processo) e i collaboratori creati dalla UI finiscono nel file
# locale data/collaborators.json. Con Redis sopravvivono ai riavvii e
# funzionano anche su un host serverless (Vercel), dove il disco è di sola lettura.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
